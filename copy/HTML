<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Личный кабинет | ДомФото</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <div class="logo">
        <img src="img/logo.png" alt="logo">
        <span>ДомФото</span>
    </div>

    <nav>
        <a href="#">фотографы</a>
        <a href="#">главная</a>
    </nav>
</header>

<main class="cabinet">

    <!-- Левая колонка -->
    <aside class="profile">

        <div class="user-info">
            <div class="avatar"></div>

            <div>
                <h3>Голубкина Татьяна</h3>
                <p>golyubkina@gmail.com</p>
                <a href="#">редактировать</a>
            </div>
        </div>

        <div class="menu">
            <a href="#">Мои заказы</a>
            <a href="#">Записаться</a>
            <a href="#">Избранное</a>

            <div class="logout">
                <a href="#">Выйти →</a>
            </div>
        </div>

    </aside>

    <!-- Правая колонка -->
    <section class="content">

        <div class="orders">

            <div class="section-header">
                <h2>Мои заказы</h2>
                <a href="#">все заказы</a>
            </div>

            <div class="order-card">

                <img src="img/order.jpg" alt="order">

                <div class="order-info">
                    <h3>Уличная фотосессия</h3>

                    <p>Дата: 6 мая 2026 16:17</p>
                    <p>Фотограф: Лина Федоровская</p>
                    <p>Статус: <strong>завершён</strong></p>
                </div>

            </div>

        </div>

        <div class="bottom-grid">

            <div class="booking">

                <h2>Запись</h2>

                <div class="booking-card">
                    <p>Выберите дату и время</p>

                    <button>Записаться</button>
                </div>

            </div>

            <div class="favorites">

                <div class="section-header">
                    <h2>Избранные</h2>
                    <a href="#">смотреть все</a>
                </div>

                <div class="gallery">

                    <img src="img/photo1.jpg" alt="">
                    <img src="img/photo2.jpg" alt="">
                    <img src="img/photo3.jpg" alt="">

                    <div class="more">
                        +3
                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<footer>

    <div>
        <h2>наши контакты</h2>

        <p>+7 996 670 65 65</p>
        <p>PHOTOs@gmail.com</p>
        <p>Прокофьева ул. д 12</p>
    </div>

    <div class="vk">
        <h2>группа vk</h2>

        <img src="img/qr.png" alt="QR">
    </div>

</footer>

</body>
</html>
